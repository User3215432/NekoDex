<UserControl x:Class="MangaLibraryApp.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <StackPanel Margin="0,6,6,0">
        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource LineBrush}"
                     BorderThickness="0"
                     Visibility="{Binding HasDeterminateProgress, Converter={StaticResource BoolVis}}"/>
        <Border Margin="0,6,0,0" Padding="6,1,6,2" CornerRadius="6" HorizontalAlignment="Left"
                Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerLineBrush}" BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding ErrorBadge}" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerBrush}"/>
        </Border>
    </StackPanel>
</UserControl>
