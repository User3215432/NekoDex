<Window x:Class="MangaLibraryApp.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reader" Width="1100" Height="900" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Eigene Titelleiste wie im Hauptfenster (dunkel, unabhängig von der Windows-Akzentfarbe). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HudTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Seiten-Schieberegler: dünne Leiste mit Akzentfüllung -->
            <Style x:Key="SliderFillStyle" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource AccentGradient}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderEmptyStyle" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" Height="22"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderThumbStyle" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Ellipse Fill="{StaticResource TextBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#22D3EE" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HudSlider" TargetType="Slider">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center" Background="Transparent">
                                <Border Height="4" CornerRadius="2" Background="{StaticResource LineBrush}"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillStyle}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyStyle}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="BottomRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titelleiste -->
        <Grid x:Name="TitleStrip" Grid.Row="0" Background="{StaticResource PanelBrush}">
            <Border Height="3" VerticalAlignment="Top" Background="{StaticResource TopLineBrush}"/>
            <TextBlock x:Name="TitleText" Margin="20,2,420,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"
                       TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock x:Name="SourceBadge" Style="{StaticResource Overline}" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,3,10,0" IsHitTestVisible="False"/>
                <Button x:Name="DirectionButton" Style="{StaticResource CaptionButton}" Content="&#xE7B3;" Click="Direction_Click"
                        ToolTip="Leserichtung: links → rechts (R)"/>
                <Button x:Name="FitButton" Style="{StaticResource CaptionButton}" Content="&#xE9A6;" Click="Fit_Click"
                        ToolTip="Ansicht: ganze Seite (F)"/>
                <Button x:Name="BrowserButton" Style="{StaticResource CaptionButton}" Content="&#xE71B;" Click="Browser_Click"
                        ToolTip="Galerie im Browser öffnen"/>
                <Button x:Name="FullscreenButton" Style="{StaticResource CaptionButton}" Content="&#xE740;" Click="Fullscreen_Click"
                        ToolTip="Vollbild (F11)"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimieren" Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximieren"
                        Click="MaximizeRestore_Click"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Schließen (Esc)" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- Anzeige -->
        <Grid x:Name="ViewerArea" Grid.Row="1" Background="#05070B" ClipToBounds="True"
              MouseLeftButtonUp="ViewerArea_MouseLeftButtonUp" PreviewMouseWheel="ViewerArea_PreviewMouseWheel">
            <ScrollViewer x:Name="PageScroller" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <Image x:Name="PageImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </ScrollViewer>

            <!-- Ladeindikator: erscheint, wenn die nächste Seite noch aus dem Netz gestreamt wird (Karte, damit der Text auch über
                 einer hellen Seite lesbar bleibt; die alte Seite scheint gedämpft durch) -->
            <Border x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                    IsHitTestVisible="False" Padding="28,18" CornerRadius="14" Background="#E6070A10"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" AutomationProperties.Name="Ladeanzeige">
                <StackPanel>
                    <TextBlock x:Name="LoadingText" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                    <Control Template="{StaticResource ScanBarTemplate}" Width="240" Height="3" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- Fehler -->
            <Border x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                    MaxWidth="560" Padding="26,22" CornerRadius="14" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource DangerLineBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="FEHLER" Style="{StaticResource Overline}" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="RetryButton" Content="Erneut versuchen" Style="{StaticResource AccentButton}" Click="Retry_Click"/>
                        <Button Content="Schließen" Style="{StaticResource HudButton}" Margin="10,0,0,0" Click="Close_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fußleiste: blättern · Seitenzahl · Schieberegler -->
        <Border x:Name="BottomBar" Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <Grid Height="50" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Vorherige Seite (←)"
                        Click="Prev_Click"/>
                <TextBlock x:Name="PageText" Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center" MinWidth="86"
                           FontFamily="{StaticResource MonoFont}" FontSize="13" Text="–"/>
                <Slider x:Name="PageSlider" Grid.Column="2" Style="{StaticResource HudSlider}" Minimum="1" Maximum="1" Value="1"
                        SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PageSlider_ValueChanged"
                        AutomationProperties.Name="Seite"/>
                <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE76C;" Margin="16,0,0,0"
                        ToolTip="Nächste Seite (→)" Click="Next_Click"/>
                <TextBlock x:Name="StatusText" Grid.Column="4" Margin="18,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{StaticResource DimBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Dünner Fensterrahmen -->
        <Border Grid.RowSpan="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" IsHitTestVisible="False"/>
    </Grid>
</Window>
